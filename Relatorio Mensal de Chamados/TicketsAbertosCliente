TicketsAbertosCliente = 
CALCULATE(
    DISTINCTCOUNT(movidesk[id]),
    movidesk[clientes] = "Cliente",
    movidesk[aptDate] >= DATE(YEAR(TODAY()), MONTH(TODAY()), 1),
    movidesk[aptDate] < EOMONTH(TODAY(), 0) + 1,
    movidesk[status] IN {
        "Aberto",
        "Aguardando Cliente",
        "Atribuído",
        "Em atendimento"
    }
)
